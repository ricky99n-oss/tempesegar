{
  "name": "tempe-segar",
  "version": "1.0.0",
  "description": "Katalog Tempe Segar tiga bahasa dengan Cloudflare D1 dan R2",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply tempe-segar-db --local",
    "db:remote": "wrangler d1 migrations apply tempe-segar-db --remote",
    "admin:create": "node scripts/create-admin.mjs",
    "dev:demo": "node scripts/dev-demo.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricky99n-oss/tempesegar.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ricky99n-oss/tempesegar/issues"
  },
  "homepage": "https://github.com/ricky99n-oss/tempesegar#readme",
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.1",
    "@opennextjs/cloudflare": "1.20.17",
    "@radix-ui/react-dialog": "1.3.1",
    "lucide-react": "1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261124.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.9"
  }
}
